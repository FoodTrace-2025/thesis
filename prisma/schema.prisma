// FoodTrace Database Schema
// Epic 2: Company & User Management
// Updated: Session 31 - Added Prisma enums for type safety
// Updated: Session 61 - Added TraceRecord model for Epic 7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL configured in prisma.config.ts for Prisma 7.x
}

// =============================================================================
// Enums - Type-safe values for status, type, and role fields
// =============================================================================

enum CompanyStatus {
  PENDING   // Awaiting PLATFORM_ADMIN approval
  APPROVED  // Approved, wallet generated
  REJECTED  // Rejected by PLATFORM_ADMIN
}

enum CompanyType {
  PRODUCER    // Farms, manufacturers - register products
  DISTRIBUTOR // Logistics, warehouses - transport products
  RETAILER    // Stores, markets - sell to consumers
}

enum UserRole {
  PLATFORM_ADMIN  // Developers - manage platform, approve companies
  COMPANY_ADMIN   // Company owner - manage company users
  PRODUCER        // Farm worker - register products, record harvests
  DISTRIBUTOR     // Driver/warehouse - receive, ship products
  RETAILER        // Store clerk - receive, sell products
}

// =============================================================================
// Company Model
// Multi-tenant company entity for supply chain participants
// =============================================================================
model Company {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  domain              String        // e.g., "hirsimakifarm.fi" - used for email validation
  status              CompanyStatus @default(PENDING)
  type                CompanyType
  rejectionReason     String?   // Reason if rejected by admin

  // Wallet fields - populated on approval (requires Epic 3.1 encryption)
  encryptedPrivateKey String?   // AES-256-GCM encrypted private key
  walletAddress       String?   @unique // Ethereum address (0x...)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  approvedAt          DateTime? // Set when status changes to APPROVED

  // Relations
  users               User[]
  auditLogs           AuditLog[]
  products            Product[] // Products registered by this company
  traceRecords        TraceRecord[] // Trace records from this company's users
  ownedProducts       Product[] @relation("ProductOwner") // Story 7.4: Products currently owned
  incomingShipments   TraceRecord[] @relation("ShipmentRecipient") // Story 7.16: Shipments coming to this company

  @@index([status])
}

// =============================================================================
// User Model
// User accounts within companies
// =============================================================================
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    // bcrypt hash (10-12 rounds)
  name         String
  role         UserRole  // Type-safe enum

  // Company relation - nullable for PLATFORM_ADMIN (no company affiliation)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())

  // Relations
  auditLogs    AuditLog[]
  products     Product[] // Products registered by this user
  traceRecords TraceRecord[] // Trace records added by this user

  @@index([companyId])
}

// =============================================================================
// AuditLog Model
// Track all significant operations for security and compliance
// Actions: CREATE_COMPANY | APPROVE_COMPANY | REJECT_COMPANY | CREATE_USER |
//          CREATE_WALLET | ENCRYPT_KEY | DECRYPT_KEY | TRANSFER_PRODUCT | etc.
// =============================================================================
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // Action type (see above)
  details   Json?    // Additional context (walletAddress, productId, error, etc.)

  // Actor - who performed the action (nullable for system actions)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  // Target company (nullable for cross-company or system actions)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  timestamp DateTime @default(now())

  // Composite indexes for efficient queries
  @@index([companyId, timestamp])
  @@index([userId, timestamp])
  @@index([action, timestamp])
}

// =============================================================================
// Product Model
// Products registered on blockchain by PRODUCER companies
// Story 5.2: Backend Prerequisites
// =============================================================================
model Product {
  id              String   @id @default(cuid())
  blockchainId    Int      @unique  // Product ID from smart contract (auto-increment)
  name            String
  origin          String
  harvestDate     DateTime
  transactionHash String   // Blockchain tx hash for registration
  qrCodeUrl       String?  // https://foodtrace.app/trace/{blockchainId}

  // Relations
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([blockchainId])

  // Story 7.4: Product Ownership Tracking
  currentOwnerId  String?
  currentOwner    Company? @relation("ProductOwner", fields: [currentOwnerId], references: [id])

  // Relation for Epic 7: Supply Chain Tracking
  traceRecords    TraceRecord[]

  @@index([currentOwnerId])
}

// =============================================================================
// TraceRecord Model
// Supply chain trace records linking products to actors and locations
// Epic 7: Supply Chain Tracking
// =============================================================================
model TraceRecord {
  id              String   @id @default(cuid())
  productId       String
  userId          String   // User who added the trace record
  companyId       String   // Company of the user
  action          String   // "RECEIVED", "QUALITY_CHECK", "SHIPPED", "STOCKED", "SOLD"
  location        String   // "Helsinki Distribution Center"
  notes           String?  // Optional quality notes
  transactionHash String   // Blockchain transaction hash
  blockchainIndex Int?     // Index in blockchain array (for verification)
  createdAt       DateTime @default(now())

  // Story 7.16: Recipient selection - who is receiving this shipment?
  recipientCompanyId String?
  recipientCompany   Company? @relation("ShipmentRecipient", fields: [recipientCompanyId], references: [id])

  // Relations
  product         Product  @relation(fields: [productId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  company         Company  @relation(fields: [companyId], references: [id])

  @@index([productId, createdAt])
  @@index([companyId])
}
