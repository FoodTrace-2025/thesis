# =============================================================================
# FoodTrace Thesis Project - Comprehensive .gitignore
# =============================================================================
# Project: Blockchain Food Traceability System
# Stack: Next.js 15 + Hardhat + Supabase + Vercel + TypeScript
# Last Updated: 2025-10-25
# =============================================================================

# =============================================================================
# ENVIRONMENT VARIABLES & SECRETS (CRITICAL - NEVER COMMIT!)
# =============================================================================
# Next.js environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Hardhat private keys & secrets
.secret
hardhat.config.ts.backup

# Keep example templates for team onboarding
!.env.example
!.env.sample

# =============================================================================
# NODE.JS DEPENDENCIES
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager files
.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

