# =============================================================================
# MISC
# =============================================================================
# Lock files (keep one, ignore others based on your package manager)
# If using npm: keep package-lock.json, ignore yarn.lock and pnpm-lock.yaml
# If using yarn: keep yarn.lock, ignore package-lock.json and pnpm-lock.yaml
# If using pnpm: keep pnpm-lock.yaml, ignore the others

# Uncomment based on your choice:
# yarn.lock
# pnpm-lock.yaml
# package-lock.json

# Local Netlify folder
.netlify

# Sentry
.sentryclirc

# Storybook
storybook-static/

# =============================================================================
# BMAD METHODOLOGY - GENERATED FILES
# =============================================================================
# QA gates and assessments are generated during development
# Keep them in version control for team visibility

# BMAD backup files (created during updates)
*.bak

# =============================================================================
# CLAUDE CODE & AI TOOLS
# =============================================================================
# Claude Code local settings (user-specific)
.claude/settings.local.json

# AI debug logs
.ai/

# Windows null device artifact
nul

# =============================================================================
# THESIS-SPECIFIC
# =============================================================================
# Thesis drafts (if you want to keep them private until submission)
# Uncomment if needed:
# docs/thesis-drafts/
# *.docx.backup

# Presentation files (if working privately)
# Uncomment if needed:
# presentations/drafts/

# =============================================================================
# KEEP THESE FILES (IMPORTANT!)
# =============================================================================
# !.gitignore               (this file)
# !README.md                (project documentation)
# !CLAUDE.md                (AI context file)
# !package.json             (dependencies)
# !tsconfig.json            (TypeScript config)
# !hardhat.config.ts        (Hardhat config)
# !prisma/schema.prisma     (database schema)
# !prisma/migrations/       (database migrations)
# !contracts/**/*.sol       (smart contracts source)
# !.env.example             (environment template)
# !.bmad-core/              (BMAD configuration)
# !docs/                    (project documentation)

# =============================================================================
# END OF .gitignore
# =============================================================================
